# Copy to .env only on first setup. Never commit real keys. Restart after changes.
# Bailian Beijing: one key for interview, transcription and speech.
AI_PROVIDER=bailian
BAILIAN_REGION=beijing
DASHSCOPE_API_KEY=
# Models default to qwen-plus / qwen3-asr-flash / qwen3-tts-flash.
# Blank fields below use Bailian defaults. Set AI_PROVIDER=generic for other providers.
# Use a provider supporting the chat/completions request format.
LLM_URL=
LLM_KEY=
LLM_MODEL=
# Optional transcription endpoint accepting multipart file/model/language.
STT_URL=
STT_KEY=
STT_MODEL=
# Optional speech endpoint accepting model/input/voice/response_format.
TTS_URL=
TTS_KEY=
TTS_MODEL=
TTS_VOICE=
